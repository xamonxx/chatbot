{
    "tech_stack": [
        "TypeScript",
        "Next.js 16 (App Router)",
        "React 19",
        "TiDB Serverless (MySQL-Compatible + Vector Search)",
        "Xenova/transformers (Local Embedding)",
        "Groq API (Llama 3.1-8b-instant LLM)",
        "Tailwind CSS 4"
    ],
    "features": [
        {
            "name": "AI Chat API",
            "description": "REST API endpoint for AI chat with RAG support, response caching, and bilingual responses. Supports comparison, proposal, and price queries with specialized handling.",
            "files": [
                "app/api/chat/route.ts",
                "app/lib/rag.ts",
                "app/lib/tidb.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "info": {
                    "title": "AI Chat API",
                    "version": "1.0.0"
                },
                "paths": {
                    "/api/chat": {
                        "post": {
                            "summary": "Send message to AI assistant",
                            "requestBody": {
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "query": {
                                                    "type": "string"
                                                },
                                                "history": {
                                                    "type": "array"
                                                },
                                                "cache": {
                                                    "type": "boolean",
                                                    "default": true
                                                }
                                            },
                                            "required": [
                                                "query"
                                            ]
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Success",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "success": {
                                                        "type": "boolean"
                                                    },
                                                    "answer": {
                                                        "type": "string"
                                                    },
                                                    "price": {
                                                        "type": "string"
                                                    },
                                                    "quotation": {
                                                        "type": "string"
                                                    },
                                                    "comparison": {
                                                        "type": "string"
                                                    },
                                                    "responseTimeMs": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Pricing Catalog API",
            "description": "REST API for accessing the full pricing catalog with filtering and category support.",
            "files": [
                "app/api/pricing-catalog/route.ts",
                "app/lib/pricing-data.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "info": {
                    "title": "Pricing Catalog API",
                    "version": "1.0.0"
                },
                "paths": {
                    "/api/pricing-catalog": {
                        "get": {
                            "summary": "Get full pricing catalog",
                            "parameters": [
                                {
                                    "name": "category",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer"
                                    }
                                },
                                {
                                    "name": "limit",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer"
                                    }
                                }
                            ],
                            "responses": {
                                "200": {
                                    "description": "Success",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "success": {
                                                        "type": "boolean"
                                                    },
                                                    "categories": {
                                                        "type": "array"
                                                    },
                                                    "totalItems": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Pricing Search API",
            "description": "REST API for searching and filtering pricing items by keyword, category, and price range.",
            "files": [
                "app/api/pricing-catalog/search/route.ts",
                "app/lib/pricing-data.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "info": {
                    "title": "Pricing Search API",
                    "version": "1.0.0"
                },
                "paths": {
                    "/api/pricing-catalog/search": {
                        "get": {
                            "summary": "Search pricing catalog",
                            "parameters": [
                                {
                                    "name": "q",
                                    "in": "query",
                                    "schema": {
                                        "type": "string"
                                    }
                                },
                                {
                                    "name": "category",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer"
                                    }
                                },
                                {
                                    "name": "minPrice",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer"
                                    }
                                },
                                {
                                    "name": "maxPrice",
                                    "in": "query",
                                    "schema": {
                                        "type": "integer"
                                    }
                                }
                            ],
                            "responses": {
                                "200": {
                                    "description": "Success",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "success": {
                                                        "type": "boolean"
                                                    },
                                                    "results": {
                                                        "type": "array"
                                                    },
                                                    "totalResults": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Rules and Guidelines API",
            "description": "REST API for accessing business rules, policies, delivery fees, and operational guidelines.",
            "files": [
                "app/api/rules/route.ts",
                "app/lib/pricing-data.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "info": {
                    "title": "Rules API",
                    "version": "1.0.0"
                },
                "paths": {
                    "/api/rules": {
                        "get": {
                            "summary": "Get business rules and guidelines",
                            "responses": {
                                "200": {
                                    "description": "Success",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "success": {
                                                        "type": "boolean"
                                                    },
                                                    "rules": {
                                                        "type": "array"
                                                    },
                                                    "policies": {
                                                        "type": "array"
                                                    },
                                                    "guidelines": {
                                                        "type": "array"
                                                    },
                                                    "operationalPolicies": {
                                                        "type": "array"
                                                    },
                                                    "deliveryFees": {
                                                        "type": "array"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Admin Run Script API",
            "description": "Admin API for running RAG setup scripts. Supports GET and POST.",
            "files": [
                "app/api/admin/run-script/route.ts",
                "scripts/setup-rag.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "info": {
                    "title": "Admin Script API",
                    "version": "1.0.0"
                },
                "paths": {
                    "/api/admin/run-script": {
                        "post": {
                            "summary": "Run admin script",
                            "requestBody": {
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "scriptName": {
                                                    "type": "string",
                                                    "enum": [
                                                        "setup-rag"
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Success"
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}