{
    "tech_stack": [
        "TypeScript",
        "Next.js 16.1.5",
        "React",
        "TailwindCSS",
        "TiDB Cloud (MySQL)",
        "OpenRouter API",
        "@xenova/transformers (RAG)"
    ],
    "features": [
        {
            "name": "Chat API",
            "description": "AI chat endpoint for customer inquiries, material comparison, and quotation generation",
            "files": [
                "app/api/chat/route.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/chat": {
                        "post": {
                            "summary": "Send message to AI chat",
                            "requestBody": {
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "messages": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "role": {
                                                                "type": "string"
                                                            },
                                                            "content": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    }
                                                },
                                                "query": {
                                                    "type": "string"
                                                },
                                                "message": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Successful response with AI answer, proposal, and comparison data"
                                }
                            }
                        },
                        "get": {
                            "summary": "Health check endpoint",
                            "responses": {
                                "200": {
                                    "description": "Status OK"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Pricing Catalog API",
            "description": "Get and filter complete product pricing catalog",
            "files": [
                "app/api/pricing-catalog/route.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/pricing-catalog": {
                        "get": {
                            "summary": "Get complete pricing catalog",
                            "responses": {
                                "200": {
                                    "description": "Returns categories with kitchen sets, wardrobes, wallpanels"
                                }
                            }
                        },
                        "post": {
                            "summary": "Filter catalog by category",
                            "requestBody": {
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "category": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Pricing Catalog Search API",
            "description": "Search and filter products with various criteria",
            "files": [
                "app/api/pricing-catalog/search/route.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/pricing-catalog/search": {
                        "post": {
                            "summary": "Search products with filters",
                            "requestBody": {
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "query": {
                                                    "type": "string"
                                                },
                                                "searchTerm": {
                                                    "type": "string"
                                                },
                                                "category": {
                                                    "type": "string"
                                                },
                                                "filters": {
                                                    "type": "object",
                                                    "properties": {
                                                        "priceRange": {
                                                            "type": "object",
                                                            "properties": {
                                                                "min": {
                                                                    "type": "number"
                                                                },
                                                                "max": {
                                                                    "type": "number"
                                                                }
                                                            }
                                                        },
                                                        "material": {
                                                            "type": "array"
                                                        },
                                                        "color": {
                                                            "type": "array"
                                                        },
                                                        "availability": {
                                                            "type": "string"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Filtered products with data, items, results arrays"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Proposal Generator API",
            "description": "Generate quotation/proposal documents",
            "files": [
                "app/api/proposal/generate/route.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/proposal/generate": {
                        "post": {
                            "summary": "Generate proposal from chat context",
                            "responses": {
                                "200": {
                                    "description": "Generated proposal text"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Rules API",
            "description": "Get operational rules and guidelines",
            "files": [
                "app/api/rules/route.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/rules": {
                        "get": {
                            "summary": "Get all business rules",
                            "responses": {
                                "200": {
                                    "description": "Array of rule items"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "name": "Admin Run Script API",
            "description": "Run administrative scripts like RAG ingestion",
            "files": [
                "app/api/admin/run-script/route.ts"
            ],
            "api_doc": {
                "openapi": "3.0.0",
                "paths": {
                    "/api/admin/run-script": {
                        "post": {
                            "summary": "Run admin script",
                            "requestBody": {
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "script": {
                                                    "type": "string",
                                                    "enum": [
                                                        "setup-rag"
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {
                                    "description": "Script execution result"
                                },
                                "400": {
                                    "description": "Invalid script or production restriction"
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}