# =====================================================
# ENVIRONMENT VARIABLES - TEMPLATE
# =====================================================
# Copy file ini ke .env.local untuk development
# Untuk Vercel: Settings > Environment Variables
# =====================================================

# === GROQ AI (untuk AI Assistant) ===
# Dapatkan API key dari: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# === GOOGLE GEMINI AI ===
# Dapatkan API key dari: https://makersuite.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# === TIDB CLOUD (Database Vector Search) ===
# Untuk fitur RAG (Retrieval Augmented Generation)
TIDB_HOST=your_tidb_host
TIDB_PORT=4000
TIDB_USER=your_tidb_user
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=your_tidb_database
